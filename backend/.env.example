# hye backend configuration. Copy to .env for local development (never commit .env).
# Every variable is validated at boot (src/config/env.validation.ts); the server refuses
# to start on invalid values. Real environment variables override this file.

# --- Runtime ------------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | log | debug | verbose (JSON lines on stdout)
LOG_LEVEL=log
# force-exit if graceful shutdown hangs
SHUTDOWN_TIMEOUT_MS=10000

# --- Persistence --------------------------------------------------------------
# memory   = in-process repositories (data is lost on restart; dev/test only)
# postgres = use DATABASE_URL (today only the imports repository has a Postgres implementation)
PERSISTENCE=memory
DATABASE_URL=postgres://hye:hye@localhost:5432/hye
DATABASE_POOL_MAX=10

# --- Redis (WebSocket fan-out across instances, rate limits, OTP/WebAuthn challenges) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO locally) -------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hye-media
S3_ACCESS_KEY=hye-minio
S3_SECRET_KEY=change-me-minio-secret

# --- Secrets (required in production, at least 32 characters each) ---------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# also keys the HMAC of OTP codes
SESSION_SECRET=
SESSION_TTL_DAYS=30

# --- Sign-in --------------------------------------------------------------------
# Phone + one-time code. Only "none" exists today: the OTP endpoints are stubs that answer
# 501 and never send an SMS. Add a provider adapter before allowing another value.
SMS_PROVIDER=none
# Passkeys (WebAuthn): the RP ID is your domain; origin is where the web client is served.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=hye
WEBAUTHN_ORIGIN=http://localhost:8081
# DEVELOPMENT ONLY: accept "x-hye-dev-user: <uuid>" instead of a session until sign-in exists.
# The server refuses to boot with this enabled when NODE_ENV=production.
AUTH_DEV_HEADER=true

# --- HTTP -----------------------------------------------------------------------
# comma-separated; empty disables CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# JSON body limit (import plans can be large)
MAX_UPLOAD_MB=50
# global rate-limit window
THROTTLE_TTL_MS=60000
# requests per window per client IP
THROTTLE_LIMIT=120

# --- Malware scanning (ClamAV clamd) for uploaded media and export archives -------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Imports --------------------------------------------------------------------
# items committed per transaction
IMPORT_BATCH_SIZE=200
# then the job pauses; continue with POST /imports/:id/resume
IMPORT_MAX_BATCHES_PER_REQUEST=50

# --- Privacy --------------------------------------------------------------------
ACCOUNT_DELETION_GRACE_DAYS=30
